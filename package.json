{
    "name": "@postalsys/gettext",
    "description": "A JavaScript implementation of gettext, a localization framework",
    "version": "4.3.0",
    "author": "Andris Reinman",
    "maintainers": [
        {
            "name": "Andris Reinman",
            "email": "andris@reinman.eu"
        }
    ],
    "homepage": "http://github.com/postalsys/gettext",
    "repository": {
        "type": "git",
        "url": "http://github.com/postalsys/gettext.git"
    },
    "type": "module",
    "main": "./dist/cjs/gettext.js",
    "types": "./dist/cjs/gettext.d.ts",
    "typesVersions": {
        "*": {
            "lib/*": [
                "dist/cjs/*.d.ts"
            ]
        }
    },
    "exports": {
        ".": {
            "import": "./dist/esm/gettext.js",
            "require": "./dist/cjs/gettext.js"
        },
        "./lib/gettext": {
            "import": "./dist/esm/gettext.js",
            "require": "./dist/cjs/gettext.js"
        },
        "./lib/gettext.js": {
            "import": "./dist/esm/gettext.js",
            "require": "./dist/cjs/gettext.js"
        },
        "./lib/plural-forms": {
            "import": "./dist/esm/plural-forms.js",
            "require": "./dist/cjs/plural-forms.js"
        },
        "./lib/plural-forms.js": {
            "import": "./dist/esm/plural-forms.js",
            "require": "./dist/cjs/plural-forms.js"
        },
        "./lib/plurals": {
            "import": "./dist/esm/plurals.js",
            "require": "./dist/cjs/plurals.js"
        },
        "./lib/plurals.js": {
            "import": "./dist/esm/plurals.js",
            "require": "./dist/cjs/plurals.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md",
        "CHANGELOG.md",
        "SECURITY.md"
    ],
    "scripts": {
        "build": "node scripts/build.js",
        "typecheck": "tsc -p tsconfig.json",
        "pretest": "npm run build",
        "test": "node --import tsx --test test/*-test.ts test/package/*-test.ts",
        "pretest:coverage": "npm run build",
        "test:coverage": "c8 node --import tsx --test test/*-test.ts test/package/*-test.ts",
        "pretest:cjs": "npm run build",
        "test:cjs": "NODE_OPTIONS=--no-experimental-require-module node test/package/cjs-smoke.cjs",
        "lint": "npm run typecheck && eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"**/*.{js,cjs,ts,json,md,yml,yaml}\"",
        "format:check": "prettier --check \"**/*.{js,cjs,ts,json,md,yml,yaml}\"",
        "predocs": "npm run build",
        "docs": "jsdoc2md -f dist/cjs/gettext.js -t docs/README.template.md --partial docs/templates/*.hbs --param-list-format list > README.md",
        "prepare": "npm run build",
        "update": "rm -rf node_modules package-lock.json && ncu -u && npm install"
    },
    "licenses": [
        {
            "type": "MIT",
            "url": "http://github.com/postalsys/gettext/blob/master/LICENSE"
        }
    ],
    "devDependencies": {
        "@types/node": "20.19.43",
        "c8": "12.0.0",
        "eslint": "10.13.0",
        "eslint-config-prettier": "10.1.8",
        "gettext-parser": "7.0.1",
        "globals": "17.13.0",
        "jsdoc-to-markdown": "9.1.3",
        "prettier": "3.9.10",
        "tsx": "4.23.15",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.2"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "keywords": [
        "i18n",
        "l10n",
        "internationalization",
        "localization",
        "translation",
        "gettext"
    ]
}
