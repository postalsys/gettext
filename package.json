{
    "name": "@postalsys/gettext",
    "description": "A JavaScript implementation of gettext, a localization framework",
    "version": "4.1.2",
    "author": "Andris Reinman",
    "maintainers": [
        {
            "name": "Andris Reinman",
            "email": "andris@reinman.eu"
        }
    ],
    "homepage": "http://github.com/postalsys/gettext",
    "repository": {
        "type": "git",
        "url": "http://github.com/postalsys/gettext.git"
    },
    "scripts": {
        "test": "node --test test/*-test.js",
        "test:coverage": "c8 npm test",
        "test:cjs": "NODE_OPTIONS=--no-experimental-require-module npm test",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "docs": "jsdoc2md -f lib/gettext.js -t docs/README.template.md --partial docs/templates/*.hbs --param-list-format list > README.md",
        "update": "rm -rf node_modules package-lock.json && ncu -u && npm install"
    },
    "main": "./lib/gettext.js",
    "files": [
        "lib",
        "test"
    ],
    "licenses": [
        {
            "type": "MIT",
            "url": "http://github.com/postalsys/gettext/blob/master/LICENSE"
        }
    ],
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "c8": "12.0.0",
        "eslint": "10.13.0",
        "eslint-config-prettier": "10.1.8",
        "globals": "17.13.0",
        "jsdoc-to-markdown": "9.1.3",
        "prettier": "3.9.10"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "keywords": [
        "i18n",
        "l10n",
        "internationalization",
        "localization",
        "translation",
        "gettext"
    ]
}
